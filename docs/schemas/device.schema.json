        "quantity": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "name",
        "quantity"
      ],
      "title": "ConditionParameter",
      "type": "object"
    },
    "Curve": {
      "additionalProperties": false,
      "description": "Dense tensor; last axis varies fastest. No simulator-specific fields.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "axes": {
          "items": {
            "$ref": "#/$defs/Axis"
          },
          "minItems": 1,
          "title": "Axes",
          "type": "array"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "title": "Values",
          "type": "array"
        },
        "unit": {
          "enum": [
            "1",
            "V",
            "A",
            "Ohm",
            "F",
            "C",
            "K",
            "J",
            "s",
            "W",
            "Hz",
            "H",
            "K/W",
            "J/K",
            "V/s",
            "A/s",
            "1/s"
          ],
          "title": "Unit",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "condition": {
          "$ref": "#/$defs/OperatingCondition",
          "default": {
            "junction_temperature": null,
            "case_temperature": null,
            "ambient_temperature": null,
            "dc_bus_voltage": null,
            "drain_current": null,
            "collector_current": null,
            "gate_voltage_on": null,
            "gate_voltage_off": null,
            "gate_resistance_on": null,
            "gate_resistance_off": null,
            "switching_frequency": null,
            "pulse_width": null,
            "duty_cycle": null,
            "gate_state": "unknown",
            "extensions": []
          }
        },
        "statistic": {
          "$ref": "#/$defs/Statistic",
          "default": "unspecified"
        },
        "uncertainty": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uncertainty"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "quality": {
          "$ref": "#/$defs/Quality",
          "default": {
            "flags": [],
            "review_status": "unreviewed"
          }
        }
      },
      "required": [
        "id",
        "name",
        "axes",
        "values",
        "unit",
        "provenance"
      ],
      "title": "Curve",
      "type": "object"
    },
    "Dependency": {
      "additionalProperties": false,

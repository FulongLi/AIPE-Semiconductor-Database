          "default": {
            "license": null,
            "redistribution_allowed": null,
            "commercial_use_allowed": null,
            "visibility": "unknown",
            "owner": null,
            "category": "unknown"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "name"
      ],
      "title": "Source",
      "type": "object"
    },
    "Statistic": {
      "enum": [
        "unspecified",
        "typical",
        "minimum",
        "maximum",
        "measured_mean",
        "median",
        "standard_deviation"
      ],
      "title": "Statistic",
      "type": "string"
    },
    "Technology": {
      "enum": [
        "Si_MOSFET",
        "SiC_MOSFET",
        "IGBT",
        "GaN",
        "diode",
        "unknown"
      ],
      "title": "Technology",
      "type": "string"
    },
    "ThermalCoupling": {
      "additionalProperties": false,
      "properties": {
        "from_component": {
          "title": "From Component",
          "type": "string"
        },
        "to_component": {
          "title": "To Component",
          "type": "string"
        },
        "thermal_model_id": {
          "title": "Thermal Model Id",
          "type": "string"
        }
      },
      "required": [
        "from_component",
        "to_component",
        "thermal_model_id"
      ],
      "title": "ThermalCoupling",
      "type": "object"
    },
    "ThermalElement": {
      "additionalProperties": false,
      "properties": {
        "resistance": {
          "$ref": "#/$defs/Quantity"
        },
        "capacitance": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "resistance",
        "capacitance"
      ],
      "title": "ThermalElement",
      "type": "object"
    },
    "ThermalNetwork": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "topology": {
          "enum": [
            "Cauer",
            "Foster"
          ],
          "title": "Topology",
          "type": "string"
        },
        "elements": {
          "items": {
            "$ref": "#/$defs/ThermalElement"
          },
          "minItems": 1,
          "title": "Elements",
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "from_node": {
          "default": "junction",
          "title": "From Node",
          "type": "string"
        },
        "to_node": {
          "default": "case",
          "title": "To Node",
          "type": "string"
        }
      },
      "required": [
        "id",
        "topology",
        "elements",
        "provenance"
      ],
      "title": "ThermalNetwork",
      "type": "object"
    },
    "Uncertainty": {
      "additionalProperties": false,
      "description": "Absolute uncertainty uses the same unit as its associated value.",
      "properties": {
        "standard": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Standard"
        },
        "repetitions": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repetitions"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "confidence_interval": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence Interval"
        },
        "confidence_level": {
          "anyOf": [
            {
              "exclusiveMaximum": 1,
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence Level"
        },
        "sample_variation": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Variation"
        }
      },
      "title": "Uncertainty",
      "type": "object"
    }
  },

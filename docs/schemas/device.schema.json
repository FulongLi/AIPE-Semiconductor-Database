        "unit": {
          "enum": [
            "1",
            "V",
            "A",
            "Ohm",
            "F",
            "C",
            "K",
            "J",
            "s",
            "W",
            "Hz",
            "H",
            "K/W",
            "J/K",
            "V/s",
            "A/s",
            "1/s"

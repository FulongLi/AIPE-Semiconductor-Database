{
  "$defs": {
    "AccessMetadata": {
      "additionalProperties": false,
      "properties": {
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "redistribution_allowed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Redistribution Allowed"
        },
        "commercial_use_allowed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commercial Use Allowed"
        },
        "visibility": {
          "default": "unknown",
          "enum": [
            "public",
            "partner",
            "private",
            "unknown"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        },
        "category": {
          "default": "unknown",
          "enum": [
            "manufacturer",
            "aipe",
            "partner",
            "licensed",
            "customer",
            "unknown"
          ],
          "title": "Category",
          "type": "string"
        }
      },
      "title": "AccessMetadata",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "checksum": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "format": {
          "minLength": 1,
          "title": "Format",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "uri",
        "checksum",
        "format",
        "size"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Availability": {
      "enum": [
        "available",
        "partial",
        "missing",
        "not_applicable",
        "unknown"
      ],
      "title": "Availability",
      "type": "string"
    },
    "Axis": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"

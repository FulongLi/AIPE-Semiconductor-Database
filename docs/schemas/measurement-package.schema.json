        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        },
        "category": {
          "default": "unknown",
          "enum": [
            "manufacturer",
            "aipe",
            "partner",
            "licensed",
            "customer",
            "unknown"
          ],
          "title": "Category",
          "type": "string"
        }
      },
      "title": "AccessMetadata",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"

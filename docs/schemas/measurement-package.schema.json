        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "checksum": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "format": {
          "minLength": 1,
          "title": "Format",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "uri",
        "checksum",
        "format",
        "size"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ConditionParameter": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
